---
import ArtPlums from "@/components/ArtPlums.astro";
import FluidIsland from "@/components/FluidIsland.astro";
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import "../globals.css";
import CV from "@cv";

interface Props {
  title: string;
}

const { title } = Astro.props;

const { image, summary, url, theme } = CV.basics;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <title>Shiro's Portfolio</title>
    <meta name="description" content={summary} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌠</text></svg>" />
    <link rel="preload" as="image" href={image} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:image" content="" />
    <meta name="referrer" content="no-referrer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={url.split("//")[1] ?? ""} />
    <meta property="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content="" />
    {CV?.analyticsCode && <script is:inline src={CV.analyticsCode} />}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Plus+Jakarta+Sans:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@200,300,400,500,600,700,800&display=swap" rel="stylesheet" />
  </head>
  <body data-theme={theme} class="relative min-h-screen bg-skin-fill text-skin-base antialiased">
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div class="absolute left-[5%] top-[10%] h-[30rem] w-[30rem] rounded-full blur-[120px] animate-float-1" style="background: radial-gradient(circle at 30% 40%, rgba(var(--color), 0.1), transparent 70%)"></div>
      <div class="absolute right-[5%] top-[30%] h-[25rem] w-[25rem] rounded-full blur-[120px] animate-float-2" style="background: radial-gradient(circle at 70% 30%, rgba(var(--color-secondary, 99, 102, 241), 0.08), transparent 70%)"></div>
      <div class="absolute left-[15%] bottom-[20%] h-[20rem] w-[20rem] rounded-full blur-[120px] animate-float-3" style="background: radial-gradient(circle at 20% 60%, rgba(var(--color), 0.06), transparent 70%)"></div>
      <div class="absolute right-[20%] top-[60%] h-[18rem] w-[18rem] rounded-full blur-[120px] animate-float-4" style="background: radial-gradient(circle at 80% 50%, rgba(var(--color-secondary, 99, 102, 241), 0.06), transparent 70%)"></div>
      <div class="absolute left-[40%] top-[50%] h-[22rem] w-[22rem] rounded-full blur-[120px] animate-float-5" style="background: radial-gradient(circle at 40% 40%, rgba(var(--color), 0.05), transparent 70%)"></div>
      <div class="absolute right-[10%] bottom-[5%] h-[16rem] w-[16rem] rounded-full blur-[120px] animate-float-6" style="background: radial-gradient(circle at 60% 60%, rgba(var(--color-secondary, 99, 102, 241), 0.05), transparent 70%)"></div>
    </div>

    <FluidIsland />

    <ArtPlums />
    <slot />

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("revealed");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: "0px 0px -60px 0px" },
        );
        document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));

        const staggerObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const items = entry.target.querySelectorAll(".stagger-item");
                items.forEach((item, i) => {
                  setTimeout(() => item.classList.add("revealed"), i * 80);
                });
                staggerObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
        );
        document.querySelectorAll(".stagger-group").forEach((el) => staggerObserver.observe(el));
      });
    </script>
  </body>
</html>
