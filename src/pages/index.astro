---
import Layout from "@/layouts/Layout.astro";

import About from "@/components/sections/About.astro";
import Experience from "@/components/sections/Experience.astro";
import Hero from "@/components/sections/Hero.astro";
import Projects from "@/components/sections/Projects.astro";
import Skills from "@/components/sections/Skills.astro";

import CV, { basics } from "@cv";
import Education from "@/components/sections/Education.astro";
import Qoute from "@/components/sections/Qoute.astro";
import Contacts from "@/components/sections/Contacts.astro";
import Certificates from "@/components/sections/Certificates.astro";
import GithubContributions from "@/components/sections/GithubContributions.astro";
import KineticMarquee from "@/components/KineticMarquee.astro";
import Gallery from "@/components/sections/Gallery.astro";
const { name, label } = basics;
---

<Layout title={`${name}'s Portfolio - ${label}`}>
  <main class="mx-auto w-full max-w-7xl px-4 py-28 md:py-36">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-8">
      <!-- Hero: spans full width -->
      <div class="md:col-span-12">
        <Hero />
      </div>

      <!-- Quote + About: left column, 7 cols -->
      <div class="flex flex-col gap-6 md:col-span-7 md:gap-8">
        <Qoute />
        <About />
        <Experience />
      </div>

      <!-- Side content: right column, 5 cols -->
      <div class="flex flex-col gap-6 md:col-span-5 md:gap-8">
        <GithubContributions />
        <Skills />
        <Education />
        <Contacts />
        <Gallery />
      </div>
      
      <!-- Projects + Images: full width bottom row -->
      <div class="flex flex-col gap-6 md:col-span-12 md:gap-8">
        <Certificates />
        <Projects />
      </div>

      <!-- Contact: full width -->
      <div class="md:col-span-12">
      </div>
    </div>

    <KineticMarquee />
  </main>
</Layout>
