---
const { className, title, eyebrow, id } = Astro.props;
---

<section
  {id}
  class:list={["outer-shell reveal", className]}
>
  <div class="inner-core flex flex-col gap-4 print:gap-2">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    {title && <h3 class="section-heading print:text-lg">{title}</h3>}
    <slot />
  </div>
</section>
