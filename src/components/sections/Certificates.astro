---
import Section from "../Section.astro";
import { certificates } from "@cv";
---

<Section className={Astro.props.className} eyebrow="Credentials" title="Certificates">
  {certificates.length > 0 && (
    <>
      <ul class="stagger-group space-y-3">
        {certificates.map(({ name, date, issuer }, i) => {
          const certificateYear = new Date(date).getFullYear();
          return (
            <li class="stagger-item glass-card" style={`--i: ${i}`}>
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div>
                  <h4 class="text-sm font-semibold text-skin-base">{name}</h4>
                  <p class="mt-0.5 text-xs text-skin-muted">{issuer}</p>
                </div>
                <span class="shrink-0 text-xs text-skin-muted">{certificateYear}</span>
              </div>
            </li>
          );
        })}
      </ul>
    </>
  )}
</Section>
