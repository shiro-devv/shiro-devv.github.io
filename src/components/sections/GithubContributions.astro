---
import Section from "../Section.astro";
import { Icon } from "astro-icon/components";
---

<Section title="GitHub Contributions">
  <div class="flex flex-col gap-4">
    <a
      href="https://github.com/shiro-devv"
      target="_blank"
      id="github-link"
      class="glass-card group flex items-center gap-3 transition-all duration-500 ease-spring hover:-translate-y-0.5"
    >
      <div class="relative flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-skin-hue/10">
        <Icon name="ri:github-fill" class="h-5 w-5 text-skin-hue" />
        <span class="pulse-dot absolute -right-0.5 -top-0.5"></span>
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-semibold text-skin-base">shiro-devv</span>
        <span id="github-stats" class="text-xs text-skin-muted" aria-live="polite">Loading...</span>
      </div>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="ml-auto shrink-0 text-skin-muted transition-transform duration-500 ease-spring group-hover:translate-x-1">
        <path d="M7 17l9.2-9.2M17 17V7H7" />
      </svg>
    </a>
  </div>
</Section>

<script>
  const GITHUB_STATS_CACHE_KEY = "github-stats-cache";
  const CACHE_DURATION_MS = 10 * 60 * 1000;

  async function fetchGithubData() {
    const statsEl = document.getElementById('github-stats');
    if (!statsEl) return;

    try {
      const cached = localStorage.getItem(GITHUB_STATS_CACHE_KEY);
      if (cached) {
        const parsed = JSON.parse(cached);
        if (Date.now() - parsed.timestamp < CACHE_DURATION_MS) {
          statsEl.textContent = parsed.value;
          return;
        }
      }

      const response = await fetch('https://api.github.com/users/shiro-devv', {
        headers: {
          'Accept': 'application/vnd.github.v3+json'
        }
      });

      if (!response.ok) throw new Error('Failed to fetch');

      const data = await response.json();
      const formatted = `${data.public_repos} repos &middot; ${data.followers} followers`;
      statsEl.textContent = formatted;
      localStorage.setItem(
        GITHUB_STATS_CACHE_KEY,
        JSON.stringify({ value: formatted, timestamp: Date.now() }),
      );
    } catch (error) {
      statsEl.textContent = 'View GitHub Profile';
      console.warn('GitHub stats load failed:', error);
    }
  }

  fetchGithubData();
</script>
