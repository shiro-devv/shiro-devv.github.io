---
import { basics } from "@cv";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

const { name, label, image, location, email } = basics;
const { city, region, address } = location;
---

<section class="reveal">
  <div class="outer-shell">
    <div class="inner-core">
      <div class="flex flex-col-reverse items-start gap-8 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex-1 space-y-5">
          <div class="space-y-3">
            <span class="eyebrow">Developer & Creator</span>
            <h1 class="font-display text-3xl font-semibold tracking-tight text-skin-base sm:text-4xl md:text-5xl gradient-text">
              {name}
            </h1>
            <div id="hero-rotating-text" class="h-7">
              <h2 class="text-base text-skin-muted sm:text-lg typewriter-cursor" id="hero-subtitle">
                {label}
              </h2>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-3 text-sm text-skin-muted">
            <Icon name="ri:map-pin-line" width={16} height={16} class="shrink-0" />
            <span>{address}, {city}, {region}</span>
          </div>

          <a
            href={`mailto:${email}`}
            class="btn-primary group"
          >
            <span>Get in touch</span>
            <span class="btn-icon-wrap">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
          </a>
        </div>

        <figure class="shrink-0">
          <div class="outer-shell w-fit">
            <div class="inner-core !p-1">
              <div class="overflow-hidden rounded-[calc(1.5rem-4px)]">
                <Image
                  class="aspect-square w-28 object-cover sm:w-32 md:w-36"
                  height={320}
                  width={320}
                  src={image}
                  alt={name}
                />
              </div>
            </div>
          </div>
        </figure>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const el = document.getElementById("hero-subtitle") as HTMLElement | null;
    if (!el) return;

    const original = el.textContent?.trim() || "";
    const phrases = [original, "Developer", "Creator", "Builder"];

    let phraseIndex = 0;
    let charIndex = 0;
    let isDeleting = false;

    function tick() {
      const current = phrases[phraseIndex];
      if (!isDeleting) {
        el!.textContent = current.slice(0, charIndex + 1);
        charIndex++;
        if (charIndex === current.length) {
          isDeleting = true;
          setTimeout(tick, 2000);
          return;
        }
      } else {
        el!.textContent = current.slice(0, charIndex - 1);
        charIndex--;
        if (charIndex === 0) {
          isDeleting = false;
          phraseIndex = (phraseIndex + 1) % phrases.length;
        }
      }
      setTimeout(tick, isDeleting ? 30 : 70);
    }

    setTimeout(tick, 1500);
  })();
</script>
