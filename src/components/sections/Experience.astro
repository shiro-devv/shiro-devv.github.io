---
import Section from "../Section.astro";
import { work } from "@cv";
import { Icon } from "astro-icon/components";
---

<Section id="experience" className={Astro.props.className} eyebrow="Career & Experience">
  <ul class="stagger-group space-y-4">
    {work.map(
      (
        { name, startDate, endDate, position, summary, responsibilities, achievements, url, skills, location, location_type },
        i,
      ) => {
        const startYear = startDate;
        const endYear = endDate != null ? endDate : "Present";

        return (
          <li class="stagger-item glass-card" style={`--i: ${i}`}>
            <div class="space-y-4">
              <header class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <h4 class="text-base font-semibold leading-tight text-skin-base">
                    {position}{" "}
                    {url ? (
                      <a class="text-skin-hue transition-colors duration-500 ease-spring hover:opacity-70" href={url} target="_blank">
                        @ {name}
                      </a>
                    ) : (
                      <span class="text-skin-muted">@ {name}</span>
                    )}
                  </h4>
                  {(location || location_type) && (
                    <p class="mt-0.5 text-xs text-skin-muted">
                      {location}{location && location_type && " · "}{location_type}
                    </p>
                  )}
                </div>
                <span class="shrink-0 rounded-full bg-skin-hue/10 px-3 py-1 text-[11px] font-medium text-skin-hue">
                  {startYear} &mdash; {endYear}
                </span>
              </header>

              {summary &&
                (Array.isArray(summary) ? (
                  <ul class="ml-4 space-y-1.5">
                    {summary.map((item) => (
                      <li class="list-disc text-sm text-skin-muted marker:text-skin-hue/40">{item}</li>
                    ))}
                  </ul>
                ) : (
                  <p class="text-sm text-skin-muted">{summary}</p>
                ))}

              {responsibilities && (
                <div class="space-y-2">
                  <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-skin-muted">Responsibilities</p>
                  <ul class="ml-4 space-y-1.5">
                    {responsibilities.map((responsibility) => (
                      <li class="list-disc text-sm text-skin-muted marker:text-skin-hue/40">{responsibility}</li>
                    ))}
                  </ul>
                </div>
              )}

              {achievements && (
                <div class="space-y-2">
                  <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-skin-muted">Achievements</p>
                  <ul class="ml-4 space-y-1.5">
                    {achievements.map((achievement) => (
                      <li class="list-disc text-sm text-skin-muted marker:text-skin-hue/40">{achievement}</li>
                    ))}
                  </ul>
                </div>
              )}

              {skills && Object.keys(skills).length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {Object.entries(skills).map(([label, icon]) => (
                    <span class="tag">
                      {icon && <Icon name={icon} width={12} height={12} />}
                      {label}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </li>
        );
      },
    )}
  </ul>
</Section>
